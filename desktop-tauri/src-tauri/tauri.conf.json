{
  "$schema": "https://schema.tauri.app/config/1",
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "",
    "devPath": "../app",
    "distDir": "../app",
    "withGlobalTauri": true
  },
  "package": {
    "productName": "PrismAI",
    "version": "0.3.1"
  },
  "tauri": {
    "allowlist": {
      "shell": {
        "open": true
      }
    },
    "bundle": {
      "active": true,
      "category": "Productivity",
      "copyright": "MIT",
      "identifier": "com.sovereign.prismai.desktop",
      "targets": "all",
      "resources": [
        "../runtime"
      ],
      "icon": [
        "icons/icon.icns",
        "icons/icon.png",
        "icons/icon.ico"
      ]
    },
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "main",
        "title": "PrismAI",
        "url": "index.html",
        "resizable": true,
        "fullscreen": false,
        "width": 1320,
        "height": 860,
        "minWidth": 1040,
        "minHeight": 720
      }
    ]
  }
}
